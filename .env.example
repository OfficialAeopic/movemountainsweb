# Move Mountains CRM Environment Variables
# Copy to .env.local and fill in. NEVER commit .env.local

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Twilio (SMS)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Resend (Email)
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# SignatureAPI (e-signatures)
SIGNATURE_API_KEY=
SIGNATURE_API_WEBHOOK_SECRET=

# App
NEXT_PUBLIC_APP_URL=https://movemountainsmarket.com
