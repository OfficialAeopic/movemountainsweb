# Move Mountains CRM Environment Variables
# Copy to .env.local and fill in. NEVER commit .env.local

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Supabase Management API (PAT for migration scripts in supabase/apply_*.py).
# Create at https://supabase.com/dashboard/account/tokens
# Never commit this. Lives only in .env.local.
SUPABASE_PAT=

# Twilio (SMS)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Resend (Email)
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# SignatureAPI (e-signatures)
SIGNATURE_API_KEY=
SIGNATURE_API_WEBHOOK_SECRET=

# App
NEXT_PUBLIC_APP_URL=https://movemountainsmarket.com

# Cron (Vercel Cron bearer token)
CRON_SECRET=
# Per-route tunables
PAYMENT_REMINDER_DAYS_LATE=1
CATEGORY_CAP_LOOKAHEAD_DAYS=14
CONTRACT_FOLLOWUP_DAYS=3
# Where category-cap-warnings emails go
ADMIN_NOTIFICATION_EMAIL=

# SignatureAPI per-location template overrides (optional)
SIGNATURE_TEMPLATE_EASTON_PARK=
SIGNATURE_TEMPLATE_WHISPER_VALLEY=
SIGNATURE_TEMPLATE_WOLF_RANCH=
SIGNATURE_TEMPLATE_GOODNIGHT_RANCH=
